{
  "name": "thitructuyen",
  "productName": "THITRUCTUYEN",
  "version": "1.0.0",
  "description": "THITRUCTUYEN",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node prepare.js && electron ."
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "vn.edu.thitructuyen",
    "productName": "THITRUCTUYEN",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "www/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-cai-dat.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable.${ext}"
    },
    "copyright": "Bản quyền thuộc về Thầy Tiến - GV Trường THPT Bỉm Sơn- Thanh Hóa"
  }
}
